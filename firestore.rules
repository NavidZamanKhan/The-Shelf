rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile document and all subcollections (e.g., documents, collections, shelves)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Recursive matching for user's subcollections (e.g. documents, collections)
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
